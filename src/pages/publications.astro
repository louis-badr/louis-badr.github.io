---
import { getCollection } from "astro:content";
import Sheet from "../layouts/Sheet.astro";
import TextLink from "../components/TextLink.astro";

const publications = (await getCollection("publications")).sort(
  (a, b) => b.data.year - a.data.year,
);
const SCHOLAR = "https://scholar.google.com/citations?user=MDSgAa4AAAAJ";
---

<Sheet
  title="Publications"
  description="Publications by Louis Badr in human-computer interaction and haptics."
  current="publications"
>
  <div class="mb-6 flex max-w-4xl flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <h1>Publications</h1>
    <TextLink href={SCHOLAR}>Google Scholar</TextLink>
  </div>
  <ol class="flex max-w-4xl flex-col">
    {publications.map(({ id, data }) => (
      <li
        id={id}
        class="relative flex flex-col gap-1 border-t border-accent py-5 transition-colors last:border-b has-[a.doi]:hover:bg-accent/5"
      >
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-xl text-balance">
            {data.doi ? (
              <a
                href={`https://doi.org/${data.doi}`}
                target="_blank"
                rel="noopener noreferrer"
                class="doi transition-colors after:absolute after:inset-0 hover:text-accent"
              >
                {data.title}
              </a>
            ) : (
              data.title
            )}
          </h2>
          <span class="shrink-0 font-plan opacity-70">{data.year}</span>
        </div>
        <p>
          {data.authors.map((a, j) => (
            <>
              {j > 0 && ", "}
              {a}
            </>
          ))}
        </p>
        <p class="text-sm">
          <span class="mr-2 rounded-sm border border-accent px-1.5 font-plan text-xs text-accent">
            {data.type}
          </span>
          <span class="italic opacity-80">{data.venue}</span>
        </p>
        {data.award && (
          <p class="flex items-center gap-1.5 text-sm font-medium text-accent">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="size-4 shrink-0"
              aria-hidden="true"
            >
              <path d="M12 2l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 16.8l-5.8 3.1 1.1-6.5L2.6 8.8l6.5-.9z" />
            </svg>
            {data.award}
          </p>
        )}
        {data.links.length > 0 && (
          <p class="relative z-10 mt-1 flex flex-wrap gap-x-4">
            {data.links.map((l) => (
              <TextLink href={l.url}>{l.label}</TextLink>
            ))}
          </p>
        )}
      </li>
    ))}
  </ol>
</Sheet>
