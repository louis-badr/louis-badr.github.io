---
// Next to the projects list, above the title block: the line drawing of
// the project under the pointer (or at the top of the list while
// scrolling), printed in the accent blue by using it as a mask.
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const items = await Promise.all(
  projects.map(async (p) => ({
    ...p,
    drawing: await getImage({ src: p.data.image, width: 960 }),
  })),
);
---

<aside class="drawings" aria-hidden="true" data-project-drawings>
  {items.map(({ id, drawing }, i) => (
    <div
      class:list={["drawing", drawing.attributes.width / drawing.attributes.height > 2 && "wide"]}
      data-project-drawing={id}
      hidden={i !== 0}
      style={`--src: url("${drawing.src}"); aspect-ratio: ${drawing.attributes.width} / ${drawing.attributes.height};`}
    />
  ))}
</aside>

<script>
  const aside = document.querySelector<HTMLElement>("[data-project-drawings]");
  const list = document.querySelector<HTMLElement>("[data-project-list]");

  if (aside && list) {
    const drawings = [
      ...aside.querySelectorAll<HTMLElement>("[data-project-drawing]"),
    ];
    const articles = [...list.querySelectorAll<HTMLElement>("article[id]")];

    const show = (id: string) => {
      drawings.forEach((d) => (d.hidden = d.dataset.projectDrawing !== id));
      articles.forEach((a) => a.toggleAttribute("data-active-project", a.id === id));
    };

    const scroller = list.closest("main");

    // Last position of a mouse over the list. Hover events don't fire when
    // the page scrolls under a still cursor, so the project under the cursor
    // is looked up from this position instead.
    let pointer: { x: number; y: number } | null = null;

    const projectUnderPointer = () => {
      if (!pointer) return undefined;
      const el = document.elementFromPoint(pointer.x, pointer.y);
      return articles.find((a) => a.contains(el));
    };

    // Without a mouse over the list: the project at the top of the view
    const projectAtTop = () => {
      const marker = scroller!.getBoundingClientRect().top + 120;
      let current = articles[0];
      for (const article of articles) {
        if (article.getBoundingClientRect().top <= marker) current = article;
        else break;
      }
      return current;
    };

    let frame = 0;
    const showCurrentProject = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        if (!scroller || articles.length === 0) return;
        show((projectUnderPointer() ?? projectAtTop()).id);
      });
    };

    scroller?.addEventListener("scroll", showCurrentProject, { passive: true });
    list.addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse") return;
      pointer = { x: e.clientX, y: e.clientY };
      showCurrentProject();
    });
    list.addEventListener("pointerleave", () => (pointer = null));
    articles.forEach((article) => {
      article.addEventListener("focusin", () => show(article.id));
    });
    showCurrentProject();
  }
</script>

<style>
  .drawings {
    position: relative;
    height: 100%;
  }

  /* A box that always fits in the space left above the title block; the
     drawing is scaled down inside it (mask: contain), never cropped. */
  .drawing {
    position: absolute;
    inset: 0;
    margin: auto;
    width: min(100% - 8rem, 22rem);
    height: min(100% - 5rem, 18rem);
    aspect-ratio: auto !important;
    background: var(--color-accent);
    mask: var(--src) center / contain no-repeat;
  }

  /* Wide drawings (the PomoTL timeline) use most of the width instead */
  .drawing.wide {
    width: min(100% - 4rem, 36rem);
  }

  .drawing[hidden] {
    display: none;
  }
</style>
