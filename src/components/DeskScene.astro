---
// The desk under the drawing sheet: an A4 cutting mat on the table, with an
// open pocket notebook (9 x 14 cm pages), its pen and a pile of 9 x 13 cm
// photo prints, all drawn to scale in centimetres of the mat (--cm).
//
// The desk (/desk/), the notes (/notes/, /notes/<id>/) and the gallery
// (/gallery/) are this one scene (scripts/desk-camera.ts): opening the
// notebook moves the camera onto it; opening the pile spreads the prints out
// on the mat, and one can be picked up to look at it closely.
import { getCollection, type CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import Pen from "./Pen.astro";
import NotesList from "./NotesList.astro";
import NoteArticle from "./NoteArticle.astro";

interface Props {
  /** Where the camera starts: the whole desk, the notebook or the prints */
  view: "desk" | "notebook" | "prints";
  /** The note open on the right page (the latest by default) */
  note?: CollectionEntry<"notes">;
  /** On phones, the camera shows one page of the notebook: the list or the note */
  focus?: "list" | "note";
}

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const { view, note = notes[0], focus = "list" } = Astro.props;

// Every photo of the gallery is a print in the pile, the latest on top
// (last in the markup). Each print keeps the proportions of its photo.
// Three sizes: the pile on the desk, the spread-out prints, one up close.
const gallery = (await getCollection("gallery")).sort(
  (a, b) => a.data.order - b.data.order,
);
const prints = await Promise.all(
  gallery.map(async ({ id, data }, i) => {
    const [thumb, pileSize, full] = await Promise.all(
      [480, 1024, 1600].map((width) =>
        getImage({ src: data.image, width, format: "webp", quality: 80 }),
      ),
    );
    return {
      id,
      thumb: thumb.src,
      pile: pileSize.src,
      full: full.src,
      animation: data.animation,
      ratio: data.image.width / data.image.height,
      caption: data.caption,
      meta: `${data.tag} • ${data.year}`,
      // A slightly different angle for each print, always the same
      rotate: (((i * 37) % 9) - 4) * 0.9,
      eager: i < 3,
    };
  }),
);
const pile = prints.slice().reverse();
---

<div class="surface relative flex size-full items-center justify-center overflow-hidden p-[2vmin]">
  <div class="scene mat" data-view={view} data-focus={focus}>
    <canvas
      aria-hidden="true"
      data-a4
      class="cutting-mat absolute inset-0 size-full"
    ></canvas>
    <div
      aria-hidden="true"
      class="mat-texture absolute inset-0 rounded-[inherit]"
    ></div>

    <!-- The pile of prints, partly under the notebook -->
    <div class="prints" role="region" aria-label="Gallery">
      {pile.map((p) => (
        <figure
          class="print"
          data-o={p.ratio >= 1 ? "l" : "p"}
          data-caption={p.caption}
          data-meta={p.meta}
          data-anim={p.animation}
          data-thumb={p.thumb}
          data-pile={p.pile}
          data-full={p.full}
          style={`--r: ${p.rotate}deg; --ratio: ${p.ratio}`}
        >
          <img
            src={p.eager ? p.pile : undefined}
            alt={p.caption}
            decoding="async"
            draggable="false"
          />
        </figure>
      ))}
      <a
        href="/gallery/"
        class="open open-prints"
        aria-label={`Look at the photos (${prints.length})`}
      ></a>
    </div>

    <!-- Open pocket notebook: an 18 x 14 cm spread on its black cover -->
    <div class="notebook" role="region" aria-label="Notebook">
      <span class="cover" aria-hidden="true"></span>
      <section class="page left" aria-label="Notes list">
        <div class="ink">
          <NotesList current={note?.id} />
        </div>
      </section>
      <section class="page right" aria-label="Note">
        <div class="ink">{note && <NoteArticle note={note} />}</div>
      </section>
      <a
        href="/notes/"
        class="open open-notes"
        aria-label="Open the notebook"
      ></a>
    </div>

    <span class="desk-pen" aria-hidden="true">
      <Pen />
    </span>

    <!-- Lamp light falling on the mat from the top left -->
    <div aria-hidden="true" class="light"></div>
  </div>

  <a
    href="/desk/"
    class="lens-out"
    aria-label="Back to the desk"
    title="Back to the desk"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="10" cy="10" r="6.5"></circle>
      <path d="M15 15l5.5 5.5M7 10h6"></path>
    </svg>
  </a>

  <!-- Under a print seen up close: its caption, and buttons to the next ones -->
  <div class="flip" aria-live="polite">
    <button
      type="button"
      class="flip-btn"
      data-flip="-1"
      aria-label="Previous photo"
    >
      ‹
    </button>
    <p>
      <b class="meta"></b>
      <span class="caption"></span>
      <span class="count"></span>
    </p>
    <button
      type="button"
      class="flip-btn"
      data-flip="1"
      aria-label="Next photo"
    >
      ›
    </button>
  </div>
</div>

<noscript>
  <style>
    .mat {
      visibility: visible !important;
    }
  </style>
</noscript>

<script>
  import { initDeskCamera } from "../scripts/desk-camera";
  initDeskCamera();
</script>

<style>
  /* An A4 cutting mat (29.7 x 21 cm), as large as the table allows,
     landscape or portrait like the screen. 1 cm of the mat = --cm.
     The camera makes the mat larger (--k) instead of scaling a picture
     of it, so text and lines stay sharp up close. */
  .surface {
    container-type: size;
  }

  .mat {
    position: relative;
    flex: none;
    container-type: size;
    aspect-ratio: 297 / 210;
    width: calc(min(100cqw, 100cqh * 297 / 210) * var(--k, 1));
    border-radius: 1.35% / 1.9%;
    background-color: var(--color-mat);
    /* A 3 mm rubber sheet: a dark edge and a short, soft shadow */
    box-shadow:
      0 1px 0 #070a1c,
      0 3px 4px rgb(0 0 0 / 0.55),
      8px 14px 34px rgb(0 0 0 / 0.5);
    transform-origin: 0 0;
  }

  .mat.zoomed {
    position: absolute;
  }

  /* Starting on the notebook or the prints: hidden until the camera is there */
  .mat:not([data-view="desk"]):not(.ready) {
    visibility: hidden;
  }

  .mat > * {
    --cm: calc(100cqw / 29.7);
  }

  @media (orientation: portrait) {
    .mat {
      aspect-ratio: 210 / 297;
      width: calc(min(100cqw, 100cqh * 210 / 297) * var(--k, 1));
      border-radius: 1.9% / 1.35%;
    }

    .mat > * {
      --cm: calc(100cqw / 21);
    }
  }

  /* Light from a lamp at the top left: a warm pool and darker far corners */
  .light {
    position: absolute;
    inset: 0;
    z-index: 4;
    border-radius: inherit;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 70% 60% at 22% 12%,
        rgb(255 244 222 / 0.12),
        transparent 70%
      ),
      radial-gradient(
        ellipse 120% 110% at 30% 25%,
        transparent 55%,
        rgb(0 0 0 / 0.28)
      );
  }

  /* On the desk, each object is one link that opens it */
  .open {
    position: absolute;
    inset: 0;
    z-index: 5;
  }

  .mat:not([data-view="desk"]) .open {
    display: none;
  }

  /* ---------- Notebook ---------- */

  .notebook {
    position: absolute;
    z-index: 2;
    left: calc(var(--cm) * 1.2);
    top: calc(var(--cm) * 1.6);
    width: calc(var(--cm) * 18);
    height: calc(var(--cm) * 14);
    rotate: -2deg;
    display: flex;
    color: var(--color-darker);
    /* About 1 cm thick: a firm contact shadow and a wide soft one */
    filter: drop-shadow(
        calc(var(--cm) * 0.1) calc(var(--cm) * 0.16) calc(var(--cm) * 0.12)
          rgb(0 0 0 / 0.55)
      )
      drop-shadow(
        calc(var(--cm) * 0.35) calc(var(--cm) * 0.55) calc(var(--cm) * 0.7)
          rgb(0 0 0 / 0.35)
      );
    transition:
      rotate 0.7s cubic-bezier(0.6, 0, 0.25, 1),
      translate 0.6s ease;
  }

  /* Up close, the notebook is put straight (turning the whole desk instead
     would blur the writing) */
  .mat[data-view="notebook"] .notebook {
    rotate: 0deg;
  }

  /* Looking at the photos: the notebook and the pen are pushed off the mat */
  .mat[data-view="prints"] .notebook {
    translate: calc(var(--cm) * -50) 0;
  }

  .mat[data-view="prints"] .desk-pen {
    translate: 0 calc(var(--cm) * -45);
  }

  /* The hard cover sticks out a few millimetres at the sides */
  .cover {
    position: absolute;
    inset: 0 calc(var(--cm) * -0.3);
    border-radius: calc(var(--cm) * 0.35);
    background: linear-gradient(135deg, #34353a, #1c1d21);
  }

  .page {
    position: relative;
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    /* 5 mm dot grid on cream paper */
    background:
      radial-gradient(
          #a7a49a calc(var(--cm) * 0.025),
          transparent calc(var(--cm) * 0.03)
        )
        0 0 / calc(var(--cm) * 0.5) calc(var(--cm) * 0.5),
      var(--color-light);
  }

  /* The paper curves down into the gutter; the outer edges show the
     stack of pages underneath */
  .page.left {
    border-radius: calc(var(--cm) * 0.25) 0 0 calc(var(--cm) * 0.25);
    box-shadow:
      inset calc(var(--cm) * -1.2) 0 calc(var(--cm) * 1) calc(var(--cm) * -0.6)
        rgb(0 0 0 / 0.28),
      calc(var(--cm) * -0.05) calc(var(--cm) * 0.05) 0 #e4dcc6,
      calc(var(--cm) * -0.1) calc(var(--cm) * 0.1) 0 #d6ceb6;
  }

  .page.right {
    border-radius: 0 calc(var(--cm) * 0.25) calc(var(--cm) * 0.25) 0;
    box-shadow:
      inset calc(var(--cm) * 1.2) 0 calc(var(--cm) * 1) calc(var(--cm) * -0.6)
        rgb(0 0 0 / 0.28),
      calc(var(--cm) * 0.05) calc(var(--cm) * 0.05) 0 #e4dcc6,
      calc(var(--cm) * 0.1) calc(var(--cm) * 0.1) 0 #d6ceb6;
  }

  /* Writing on the pages, sized in centimetres so it scales with the
     notebook. It can be scrolled once the camera is on the notebook. */
  .ink {
    display: flex;
    flex-direction: column;
    min-height: 0;
    flex: 1;
    overflow: hidden;
    padding: calc(var(--cm) * 0.75) calc(var(--cm) * 0.7) calc(var(--cm) * 0.5);
    font-size: calc(var(--cm) * 0.3);
    line-height: 1.5;
  }

  .mat[data-view="notebook"] .ink {
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .ink :global(h1) {
    font-size: 1.9em;
    line-height: 1.15;
    margin: 0;
  }
  .ink :global(h2) {
    font-size: 1.35em;
    line-height: 1.25;
  }
  .ink :global(h3) {
    font-size: 1.15em;
  }
  .ink :global(.text-sm) {
    font-size: 0.85em;
  }
  .ink :global(.text-lg) {
    font-size: 1.1em;
  }
  .ink :global(.note > * + *) {
    margin-top: 0.75em;
  }
  .ink :global(.note h2) {
    margin-top: 1.6em;
  }
  .ink :global(.note :is(ol, ul)) {
    padding-left: 1.6em;
  }
  .ink :global(.note table) {
    font-size: 0.85em;
  }
  .ink :global(.space-y-4 > * + *) {
    margin-top: 1em;
  }

  /* ---------- Pen: 14 cm long, standing off the mat ---------- */

  .desk-pen {
    position: absolute;
    z-index: 3;
    left: calc(var(--cm) * 24.6);
    top: calc(var(--cm) * 1.2);
    width: calc(var(--cm) * 1.4);
    height: calc(var(--cm) * 14);
    rotate: 8deg;
    pointer-events: none;
    filter: drop-shadow(
      calc(var(--cm) * 0.22) calc(var(--cm) * 0.32) calc(var(--cm) * 0.18)
        rgb(0 0 0 / 0.5)
    );
    transition: translate 0.6s ease;
  }

  /* ---------- Prints: borderless photo paper ----------
     Each print is drawn at 26 cm on its long side and scaled down (--s):
     13 cm in the pile, a few centimetres spread out, large up close. It
     is only ever shrunk, so the photo stays sharp. Its proportions are
     those of the photo: nothing is cropped or stretched. */

  .prints {
    position: absolute;
    z-index: 1;
    left: calc(var(--cm) * 16.4);
    top: calc(var(--cm) * 6.6);
    width: calc(var(--cm) * 13);
    height: calc(var(--cm) * 13);
  }

  /* Looking at the photos: the prints come over everything else */
  .mat[data-view="prints"] .prints {
    z-index: 6;
  }

  .print {
    position: absolute;
    left: 50%;
    top: 50%;
    margin: 0;
    width: calc(var(--cm) * 26);
    aspect-ratio: var(--ratio);
    transform: translate(-50%, -50%) translate(var(--dx, 0px), var(--dy, 0px))
      rotate(var(--rot, var(--r))) scale(var(--s, 0.5));
    transition: transform 0.6s cubic-bezier(0.5, 0, 0.25, 1);
    border-radius: calc(var(--cm) * 0.12);
    overflow: hidden;
    background: #1a1a1a;
    /* Paper this thin barely lifts off what is below */
    box-shadow:
      calc(var(--cm) * 0.04) calc(var(--cm) * 0.08) calc(var(--cm) * 0.1)
        rgb(0 0 0 / 0.45),
      calc(var(--cm) * 0.2) calc(var(--cm) * 0.36) calc(var(--cm) * 0.6)
        rgb(0 0 0 / 0.2);
  }

  .print[data-o="p"] {
    width: auto;
    height: calc(var(--cm) * 26);
  }

  /* Only the top few prints of the pile can be seen */
  .print:nth-last-child(n + 7) {
    visibility: hidden;
  }

  .mat[data-view="prints"] .print {
    visibility: visible;
    cursor: zoom-in;
  }

  .mat[data-view="prints"] .print.focus {
    z-index: 50;
    cursor: zoom-out;
  }

  /* A glossy sheen on the photo paper, catching the lamp */
  .print::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      130deg,
      rgb(255 255 255 / 0.18),
      transparent 38%
    );
    pointer-events: none;
  }

  .print img {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ---------- Controls over the scene ---------- */

  .lens-out {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .surface:has(.mat:not([data-view="desk"])) .lens-out {
    opacity: 1;
    pointer-events: auto;
  }

  /* The caption, on a cream paper label laid under the photo */
  .flip {
    position: absolute;
    left: 50%;
    bottom: max(2.5rem, 6vh);
    /* Above every print on the mat */
    z-index: 60;
    translate: -50% 0;
    rotate: -0.4deg;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: max-content;
    max-width: min(46rem, calc(100% - 2rem));
    padding: 0.5rem 0.6rem;
    border-radius: 2px;
    background: var(--color-paper);
    color: var(--color-darker);
    font-size: var(--text-base);
    line-height: 1.35;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.45),
      4px 8px 18px rgb(0 0 0 / 0.35);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .surface:has(.mat[data-view="prints"].focusing) .flip {
    opacity: 1;
    pointer-events: auto;
  }

  .flip p {
    min-width: 0;
    text-align: center;
    text-wrap: balance;
  }

  .flip .meta {
    display: block;
    font-family: var(--font-plan);
    font-weight: 400;
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  .flip .count {
    margin-left: 0.6em;
    font-family: var(--font-plan);
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .flip-btn {
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  .flip-btn {
    color: var(--color-accent);
  }

  .flip-btn:hover,
  .flip-btn:focus-visible {
    background: var(--color-accent);
    color: var(--color-paper);
  }

  /* ---------- Portrait mat (phones): notebook on top, prints below ---------- */

  @media (orientation: portrait) {
    .notebook {
      left: calc(var(--cm) * 1.5);
      top: calc(var(--cm) * 1.2);
      rotate: -1.5deg;
    }

    .desk-pen {
      left: calc(var(--cm) * 16.4);
      top: calc(var(--cm) * 15.6);
      rotate: 10deg;
    }

    .prints {
      left: calc(var(--cm) * 1.8);
      top: calc(var(--cm) * 15.8);
    }
  }
</style>
